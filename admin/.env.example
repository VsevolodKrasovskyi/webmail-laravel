APP_NAME="Mail Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The admin panel runs on the host (php artisan serve / host php-fpm), never
# in Docker — this always points at Postgres's published port.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# Must match the ./docker/data/dkim bind mount in docker-compose.yml (the
# default below is relative to the admin/ directory, i.e. `cd admin && php
# artisan serve`). rspamd reads keys from there to sign outgoing mail.
DKIM_KEYS_PATH=../docker/data/dkim
MAIL_DEFAULT_QUOTA_MB=3072
APP_DOMAIN=mail.example.com

# Read once by `php artisan db:seed` to create the first admin account.
# Blank = seeder no-ops (safe to leave blank after the first run).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

CLOUDFLARE_API_TOKEN=

# Lets the admin panel open any mailbox's webmail without knowing its real
# password, via Dovecot master-user auth (docker/dovecot/10-auth.conf).
DOVECOT_MASTER_PASSWORD=change-me

# Dovecot/Postfix published ports on this same host (see docker-compose.yml).
IMAP_HOST=127.0.0.1
SMTP_HOST=127.0.0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true once this is actually served over HTTPS (e.g. behind the host nginx);
# false for plain-HTTP `php artisan serve`, or the browser will never send
# the cookie back and login will loop.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
