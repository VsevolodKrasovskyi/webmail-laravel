APP_NAME="Mail Admin"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Set APP_ENV=production and APP_DEBUG=false on a real server.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Used for dates in the UI, reports and CSV exports.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The admin panel runs on the host (php artisan serve / host php-fpm), never
# in Docker — this always points at Postgres's published port.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# Must match the ./docker/data/dkim bind mount in docker-compose.yml (the
# default below is relative to the admin/ directory, i.e. `cd admin && php
# artisan serve`). rspamd reads keys from there to sign outgoing mail.
DKIM_KEYS_PATH=../docker/data/dkim
MAIL_DEFAULT_QUOTA_MB=3072
APP_DOMAIN=mail.example.com

# Who may sign in. Login is Google-only: a Google account is accepted when its
# verified email is in this comma-separated list (a@example.com,b@example.com).
# The admin user is created on the first sign-in, there are no passwords.
ADMIN_EMAIL=you@example.com

# Optional. API token with Zone:DNS:Edit, enables "Sync DNS" on the Domains page.
CLOUDFLARE_API_TOKEN=

# Same value as the root .env. Lets the admin panel open any mailbox's webmail
# and send scheduled mail without storing mailbox passwords, via Dovecot
# master-user auth (docker/dovecot/conf.d/10-auth.conf). Keep it secret.
DOVECOT_MASTER_PASSWORD=change-me

# Dovecot/Postfix published ports on this same host (see docker-compose.yml).
IMAP_HOST=127.0.0.1
SMTP_HOST=127.0.0.1

# Required for login. OAuth client (type "Web application") from the Google Cloud
# console. GOOGLE_REDIRECT_URI must also be listed there as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true once this is actually served over HTTPS (e.g. behind the host nginx);
# false for plain-HTTP `php artisan serve`, or the browser will never send
# the cookie back and login will loop.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Laravel's own outgoing mail. The panel does not use it today (webmail talks to
# your SMTP server directly), so "log" is fine. To let the panel send system mail
# later, use your own server with a dedicated mailbox:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=mail.example.com
# MAIL_PORT=587
# MAIL_USERNAME=no-reply@example.com
# MAIL_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
