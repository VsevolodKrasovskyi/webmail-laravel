# Only what differs from the framework defaults. Everything else (sessions, cache,
# queue and logging in the database or files, English locale, the Dovecot and
# Postfix hosts on 127.0.0.1, 3 GB default quota) works without being set here.

APP_NAME="Mail Admin"
# production on a real server, with APP_DEBUG=false
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public URL of the panel. The Google redirect URI is APP_URL + /auth/google/callback.
APP_URL=http://127.0.0.1:8000
# Used for dates in the UI, reports and CSV exports.
APP_TIMEZONE=UTC

# The panel runs on the host and reaches Postgres on its published loopback port.
# Same DB_* values as the root .env.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# The mail server hostname, the same APP_DOMAIN as the root .env. Used as the MX
# target when syncing DNS.
APP_DOMAIN=mail.example.com

# Same value as the root .env. Lets the panel open any mailbox's webmail and send
# scheduled mail without storing mailbox passwords, via Dovecot master-user auth.
# Keep it secret, it grants access to every mailbox.
DOVECOT_MASTER_PASSWORD=change-me

# Who may sign in. Login is Google-only: a Google account is accepted when its
# verified email is in this comma-separated list (a@example.com,b@example.com).
# The admin user is created on the first sign-in, there are no passwords.
ADMIN_EMAIL=you@example.com
# OAuth client (type "Web application") from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true once the panel is served over HTTPS, otherwise the login cookie is never
# sent back and sign-in loops. Leave false for plain-HTTP `php artisan serve`.
SESSION_SECURE_COOKIE=false

# Optional. API token with Zone:Zone:Read and Zone:DNS:Edit, enables "Sync DNS".
CLOUDFLARE_API_TOKEN=
