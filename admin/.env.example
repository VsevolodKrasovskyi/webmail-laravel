# Only what differs from the framework defaults. Everything else (sessions, cache,
# queue and logging in the database or files, English locale, the Dovecot and
# Postfix hosts on 127.0.0.1, 3 GB default quota) works without being set here.
# ./install.sh creates this file for you with the right values.
#
# Not here on purpose: there is no administrator or Cloudflare setting. On the first
# run, while there are no users, the panel offers to register (or sign in with Google)
# and that first user becomes the administrator. Other users join by invitation and an
# administrator can make other users administrators on the Users page. Cloudflare API
# keys are added on the API keys page, several accounts are supported.

APP_NAME="Mail Admin"
# production on a real server, with APP_DEBUG=false
APP_ENV=local
# Generate with: php artisan key:generate
# Back it up and never change it: it also encrypts the two-factor secrets and the saved
# API keys, a new key makes them unreadable (everyone is signed out too).
APP_KEY=
APP_DEBUG=true
# Public URL of the panel. The Google redirect URI is APP_URL + /auth/google/callback.
APP_URL=http://127.0.0.1:8000
# Used for dates in the UI, reports and CSV exports.
APP_TIMEZONE=UTC

# The panel runs on the host and reaches Postgres on its published loopback port.
# Same DB_* values as the root .env.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# The mail server hostname, the same APP_DOMAIN as the root .env. Used as the MX
# target when syncing DNS.
APP_DOMAIN=mail.example.com

# Same value as the root .env. Lets the panel open any mailbox's webmail and send
# scheduled mail without storing mailbox passwords, via Dovecot master-user auth.
# Keep it secret, it grants access to every mailbox.
DOVECOT_MASTER_PASSWORD=change-me

# System e-mail (invitations, verification, password reset) goes through this stack's
# own Postfix. MAIL_FROM_ADDRESS must be an existing, active mailbox of a domain added
# in the panel (create it after the first sign-in), the panel signs in as it with the
# Dovecot master user. Without it no system e-mail is sent.
MAIL_MAILER=postfix
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Mail Admin"

# Optional, enables "Sign in with Google". OAuth client (type "Web application") from
# the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true once the panel is served over HTTPS, otherwise the login cookie is never
# sent back and sign-in loops. Leave false for plain-HTTP `php artisan serve`.
SESSION_SECURE_COOKIE=false
