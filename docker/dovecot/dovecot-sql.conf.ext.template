driver = pgsql
connect = host=${DB_HOST} port=${DB_PORT} dbname=${DB_DATABASE} user=${DB_USERNAME} password=${DB_PASSWORD}

default_pass_scheme = SHA512-CRYPT

password_query = \
  SELECT email as user, password \
  FROM mailboxes \
  WHERE email = '%u' AND is_active = true

user_query = \
  SELECT email as user, 5000 as uid, 5000 as gid, \
    concat('/var/mail/vhosts/', split_part(email, '@', 2), '/', split_part(email, '@', 1)) as home, \
    concat('*:storage=', quota_mb, 'M') as quota_rule \
  FROM mailboxes \
  WHERE email = '%u' AND is_active = true

iterate_query = SELECT email as user FROM mailboxes WHERE is_active = true
