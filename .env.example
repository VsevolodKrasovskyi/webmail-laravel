# Copy this file to .env and fill in real values before running docker compose.

# The single domain this whole stack serves: mail hostname (MX/PTR target),
# TLS certificate (Postfix + Dovecot both read it from the host's own
# certbot, see README "TLS certificates"), and the admin panel's own URL.
APP_DOMAIN=mail.example.com
MAIL_DOMAIN=example.com

# PostgreSQL (shared by Laravel, Postfix and Dovecot)
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# Admin panel login, created automatically on first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Lets the admin panel open any mailbox's webmail (Mailboxes -> inbox icon)
# without knowing its real password, via Dovecot master-user auth. Required
# — pick a long random value, it grants access to every mailbox.
DOVECOT_MASTER_PASSWORD=change-me

# Optional: lets the admin panel create/update MX, SPF, DKIM and DMARC
# records directly in Cloudflare (Domains -> "Sync DNS"). Needs a Cloudflare
# API token with Zone:DNS:Edit permission on the zones you'll manage. Leave
# empty to disable — DNS stays something you set up manually (see README).
CLOUDFLARE_API_TOKEN=
