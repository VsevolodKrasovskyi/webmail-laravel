# Copy to .env and fill in real values before `docker compose up`.
# Used by docker-compose.yml only (Postgres, Postfix, Dovecot). The Laravel admin
# panel reads its own admin/.env, see admin/.env.example. DB_* and
# DOVECOT_MASTER_PASSWORD must have the same values in both files.
#
# Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# Mail server hostname. MX/PTR target, TLS certificate name (Postfix and Dovecot
# read /etc/letsencrypt/live/<APP_DOMAIN>/ from the host's certbot) and the
# admin panel URL.
APP_DOMAIN=mail.example.com
# Default mail domain (postfix "mydomain").
MAIL_DOMAIN=example.com

# PostgreSQL, shared by Laravel, Postfix and Dovecot.
DB_DATABASE=mailserver
DB_USERNAME=mailserver
DB_PASSWORD=change-me

# Lets the admin panel open any mailbox's webmail without knowing its real
# password, via Dovecot master-user auth. Anyone who knows this value can read
# every mailbox over IMAP, so make it long and random. Dovecot refuses to start
# while it is empty or "change-me".
DOVECOT_MASTER_PASSWORD=change-me
